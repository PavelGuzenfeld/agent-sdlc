{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/bin/say-hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/git-guardrail.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(git *)",
      "Bash(git)",
      "Bash(git push --force-with-lease *)",
      "Bash(gh *)",
      "Bash(docker *)",
      "Bash(docker)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(tree *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(md5sum *)",
      "Bash(sha256sum *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(jq *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(tee *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(ln *)",
      "Bash(ps *)",
      "Bash(pgrep *)",
      "Bash(lsof *)",
      "Bash(ss *)",
      "Bash(uname *)",
      "Bash(free *)",
      "Bash(uptime)",
      "Bash(command *)",
      "Bash(type *)",
      "Bash(test *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(make *)",
      "Bash(make)",
      "Bash(cmake *)",
      "Bash(ninja *)",
      "Bash(colcon *)",
      "Bash(cargo build *)",
      "Bash(cargo install *)",
      "Bash(cargo run *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm start *)",
      "Bash(npm start)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(apt install *)",
      "Bash(apt-get install *)",
      "Bash(sudo *)",
      "Bash(ctest *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(./*)"
    ]
  }
}
